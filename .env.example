# ---- Stripe ----------------------------------------------------------------
# Brittany's Stripe account. Use the test keys until she is ready to go live.
STRIPE_SECRET_KEY=sk_test_xxx

# Developers > Webhooks > add endpoint https://YOURDOMAIN/api/stripe/webhook
# subscribed to checkout.session.completed, then paste the signing secret here.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Site ------------------------------------------------------------------
# Used to build Stripe return URLs and download links in emails.
NEXT_PUBLIC_SITE_URL=https://sprinklesandsparklesbb.vercel.app

# ---- Order emails (optional, Resend) ---------------------------------------
RESEND_API_KEY=re_xxx
ORDER_FROM=orders@glazedweb.com
ORDER_TO=sprinklesandsparklesbb@gmail.com

# ---- Digital product files -------------------------------------------------
